\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pgreport}[2025/09/16 Clean journal-like style (sans-serif, blue headings)]

% --- Citations and Bibliography ---
\RequirePackage[numbers,square]{natbib}
\providecommand{\pg@bibstyle}{unsrtnat}
\bibliographystyle{\pg@bibstyle}

% --- Hyperlinks ---
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=purple,
  urlcolor=blue,
  citecolor=cyan,
  anchorcolor=black
}

% --- Author Management ---
\RequirePackage{authblk}
\renewcommand\Authfont{\normalsize\raggedright}
\renewcommand\Affilfont{\small\raggedright}
\setlength{\affilsep}{0.5em}

% --- ORCID Integration ---
\RequirePackage{orcidlink}

% --- Supplementary Figures ---
\RequirePackage{newfloat}
\DeclareFloatingEnvironment[name={Supplementary Figure}]{suppfigure}
\RequirePackage{sidecap}
\sidecaptionvpos{figure}{c}

% --- Section spacing ---
\RequirePackage{titlesec}

% --- Line Numbers (optional) ---
\RequirePackage{lineno}

% --- Fonts: Times-like text + math (newtx) ---
\IfFileExists{newtxtext.sty}{\RequirePackage{newtxtext}}{\RequirePackage{times}}
\IfFileExists{newtxmath.sty}{\RequirePackage{newtxmath}}{}

% --- Encoding and micro-typography ---
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}

% --- Geometry (A4 defaults) ---
\RequirePackage[a4paper]{geometry}
\geometry{
  textheight=24.0cm,
  textwidth=17.6cm,
  top=2.0cm,
  headheight=12pt,
  headsep=10pt,
  footskip=18pt
}

% --- Header/footer & Titlebar ---
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
% --- Corporate Accent Color ---
\definecolor{accentblue}{RGB}{0,80,155} % #00509b
\newcommand{\headlinetext}{Abschlussbericht} % überschreibbar im Dokument

\newcommand{\firstpagebar}{%
  \begin{tikzpicture}[remember picture,overlay,shift={(current page.north west)}]
    % Balken mit 2mm Überstand links/rechts gegen Anti-Aliasing-Haarlinien
    \fill[accentblue] (-2mm,0) rectangle (\paperwidth+2mm,-1.2cm);
    \node[anchor=west, font=\sffamily\bfseries\large, text=white]
      at (1.2cm,-0.6cm) {\headlinetext};
  \end{tikzpicture}%
}

\fancyhf{}
\pagestyle{fancy}
\setlength{\headsep}{25pt}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{accentblue}\leaders\hrule height \headrulewidth\hfill}}
\lhead{\small\color{accentblue}\vspace{-8pt}\@title}
\rhead{\small\color{accentblue}\vspace{-8pt}\thepage}

\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \AddToShipoutPicture*{\firstpagebar}
}

% --- Keywords ---
\newcommand{\keywordname}{{\color{accentblue}\sffamily\bfseries Keywords}}
\newcommand{\keywords}[1]{%
  \par\smallskip
  {\small \keywordname\enspace #1\par}
}

% --- Penalties and spacing ---
\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

% --- Sizes (tighter leading) ---
\makeatletter
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize\@xpt\@xipt
  \abovedisplayskip      7\p@ \@plus 2\p@ \@minus 5\p@
  \abovedisplayshortskip \z@ \@plus 3\p@
  \belowdisplayskip      \abovedisplayskip
  \belowdisplayshortskip 4\p@ \@plus 3\p@ \@minus 3\p@
}
\normalsize
\renewcommand{\small}{%
  \@setfontsize\small\@ixpt\@xpt
  \abovedisplayskip      6\p@ \@plus 1.5\p@ \@minus 4\p@
  \abovedisplayshortskip \z@  \@plus 2\p@
  \belowdisplayskip      \abovedisplayskip
  \belowdisplayshortskip 3\p@ \@plus 2\p@   \@minus 2\p@
}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@ixpt\@xpt}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viipt\@viiipt}
\renewcommand{\tiny}{\@setfontsize\tiny\@vipt\@viipt}
\renewcommand{\large}{\@setfontsize\large\@xiipt{14}}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt{16}}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xviipt{20}}
\renewcommand{\huge}{\@setfontsize\huge\@xxpt{23}}
\renewcommand{\Huge}{\@setfontsize\Huge\@xxvpt{28}}

% --- Sectioning (sans-serif + blue) ---
\titlespacing\section{0pt}{12pt plus 3pt minus 3pt}{4pt plus 1pt minus 1pt}
\titlespacing\subsection{0pt}{10pt plus 3pt minus 3pt}{3pt plus 1pt minus 1pt}
\titlespacing\subsubsection{0pt}{8pt plus 3pt minus 3pt}{2pt plus 1pt minus 1pt}

\renewcommand{\section}{%
  \@startsection{section}{1}{\z@}%
    {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
    { 1.5ex \@plus  0.3ex \@minus  0.2ex}%
    {\large\sffamily\bfseries\color{accentblue}\raggedright}%
}
\renewcommand{\subsection}{%
  \@startsection{subsection}{2}{\z@}%
    {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
    { 0.8ex \@plus  0.2ex}%
    {\normalsize\sffamily\bfseries\color{accentblue}\raggedright}%
}
\renewcommand{\subsubsection}{%
  \@startsection{subsubsection}{3}{\z@}%
    {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
    { 0.5ex \@plus  0.2ex}%
    {\normalsize\sffamily\bfseries\color{accentblue}\raggedright}%
}

% --- Floats ---
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.4}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.7}
\newlength{\@abovecaptionskip}\setlength{\@abovecaptionskip}{7\p@}
\newlength{\@belowcaptionskip}\setlength{\@belowcaptionskip}{\z@}
\setlength{\abovecaptionskip}{\@abovecaptionskip}
\setlength{\belowcaptionskip}{\@belowcaptionskip}
\renewenvironment{table}
  {\setlength{\abovecaptionskip}{\@belowcaptionskip}%
   \setlength{\belowcaptionskip}{\@abovecaptionskip}%
   \@float{table}}
  {\end@float}

% --- Paragraphs & lists ---
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5\p@}
\setlength{\topsep}{4\p@ \@plus 1\p@ \@minus 2\p@}
\setlength{\itemsep}{2\p@ \@plus 1\p@ \@minus 0.5\p@}

% --- Title block (left-aligned, with first-page bar) ---
\renewcommand{\maketitle}{%
  \thispagestyle{firstpage}%
  \par\begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}
    \renewcommand{\@makefnmark}{\hbox to \z@{$^{\@thefnmark}$\hss}}
    \vspace*{1.2cm}% Platz unter Balken
    \@maketitle
    \@thanks
  \endgroup
  \let\maketitle\relax
  \let\thanks\relax
}

\renewcommand{\@maketitle}{%
  \vbox{%
    \hsize\textwidth
    \raggedright
    {\LARGE\bfseries\sffamily\color{accentblue} \@title\par}
    \vskip 0.6em
    {\normalsize \@author\par}
    \vskip 0.8em
  }%
}

% --- Abstract styling (sans-serif + blue label) ---
\renewenvironment{abstract}
{%
  \par\medskip
  \noindent{{\large\sffamily\bfseries\color{accentblue} Abstract}}\par
  \vspace{0.25em}
  \begingroup\small
}
{%
  \par\endgroup
  \medskip
}
\makeatother